diff --git a/tests/test_scheduler.py b/tests/test_scheduler.py
index 1548978..cf0f9a0 100644
--- a/tests/test_scheduler.py
+++ b/tests/test_scheduler.py
@@ -84,3 +84,35 @@ def test_preemption_recomputes_without_duplicate_output():
     assert s.is_finished()
     assert len(a.completion_token_ids) == len(b.completion_token_ids) == 3
     assert len(s.block_manager.free_block_ids) == 2
+
+
+def test_mixed_prefill_cap_preserves_pure_prefill_budget():
+    from wwvllm.engine.scheduler_output import ExecutionMode
+    s = scheduler(budget=8, chunk=8, blocks=16)
+    s.max_mixed_prefill_tokens = 3
+    a = Sequence([1, 2], SamplingParams(max_tokens=4))
+    s.add(a)
+    s.postprocess(s.schedule(), [9])
+    b = Sequence(list(range(12)))
+    c = Sequence(list(range(20, 32)))
+    s.add(b)
+    s.add(c)
+    out = s.schedule()
+    assert out.has_decode and out.has_prefill
+    assert sum(item.num_scheduled_tokens for item in out.scheduled if item.mode == ExecutionMode.PREFILL) == 3
+    assert out.num_scheduled_tokens == 4
+    s.postprocess(out, [10])
+    # Without a concurrent decode, the ordinary prefill chunk can use the full budget.
+    s.cancel(a)
+    out = s.schedule()
+    assert not out.has_decode and out.num_scheduled_tokens == 8
+
+
+def test_mixed_prefill_cap_can_be_disabled():
+    s = scheduler(budget=8, chunk=8, blocks=16)
+    a = Sequence([1, 2])
+    s.add(a)
+    s.postprocess(s.schedule(), [9])
+    s.add(Sequence(list(range(12))))
+    out = s.schedule()
+    assert out.has_decode and out.has_prefill and out.num_scheduled_tokens == 8
diff --git a/tests/test_speculative.py b/tests/test_speculative.py
index 9fa299a..8509625 100644
--- a/tests/test_speculative.py
+++ b/tests/test_speculative.py
@@ -123,3 +123,27 @@ def test_eos_truncates_accepted_proposals():
         assert len(s.block_manager.free_block_ids) == 4
     finally:
         Sequence.block_size = old
+
+
+def test_speculative_decode_obeys_mixed_prefill_cap():
+    from wwvllm.engine.scheduler_output import ExecutionMode
+    old = Sequence.block_size
+    Sequence.block_size = 4
+    try:
+        config = SimpleNamespace(max_num_seqs=2, max_num_batched_tokens=8,
+            prefill_chunk_size=8, max_mixed_prefill_tokens=3, eos=-1,
+            kvcache_block_size=4, num_kvcache_blocks=16,
+            enable_speculative=True, speculative_num_tokens=2)
+        s = Scheduler(config)
+        first = Sequence([1, 2], SamplingParams(max_tokens=6))
+        s.add(first)
+        s.postprocess(s.schedule(), [9])
+        s.add(Sequence(list(range(10))))
+        out = s.schedule()
+        assert out.has_decode and out.has_prefill
+        assert out.scheduled[0].mode == ExecutionMode.SPECULATIVE
+        assert sum(item.num_scheduled_tokens for item in out.scheduled if item.mode == ExecutionMode.PREFILL) == 3
+        assert out.num_scheduled_tokens == 6
+        s.block_manager.rollback_transaction(out.scheduled[0].transaction)
+    finally:
+        Sequence.block_size = old
